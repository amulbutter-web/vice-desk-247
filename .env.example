# ==============================================================================
# Gaming Content Intelligence & Vice Desk Environment Configuration
# ==============================================================================

# Application & Environment
APP_NAME="Vice Desk Intelligence Studio"
ENVIRONMENT="production"
PORT=8000
HOST="0.0.0.0"

# Database Configuration (Defaults to high-concurrency WAL SQLite)
# To use Supabase PostgreSQL, uncomment and insert your database password:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.vxbtaekawtpnaxrmduxj.supabase.co:5432/postgres"
DATABASE_URL="sqlite:///data/platform.db"

# Meta / Instagram Reels Graph API Configuration (Optional - for direct 1-click cloud publishing)
# META_APP_ID="your_meta_app_id"
# META_APP_SECRET="your_meta_app_secret"
# INSTAGRAM_ACCESS_TOKEN="EAAB..."
# INSTAGRAM_BUSINESS_ACCOUNT_ID="1784..."

# Stream Concurrency & RingBuffer
TARGET_CONCURRENT_STREAMS=5
RING_BUFFER_DURATION_SEC=120

# System Safety & Emergency Kill Switch
EMERGENCY_KILL_SWITCH=false
