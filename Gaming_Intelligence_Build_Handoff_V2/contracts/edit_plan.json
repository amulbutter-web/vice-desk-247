{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "edit_plan",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "event_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "media_asset_id": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "enum": [
        "instagram",
        "youtube"
      ]
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "source_end_ms": {
            "type": "integer",
            "minimum": 1
          },
          "time_epoch": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_start_ms",
          "source_end_ms",
          "time_epoch",
          "reason"
        ]
      }
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height",
        "fps"
      ],
      "additionalProperties": false
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "crop",
              "zoom",
              "overlay_text",
              "subtitle",
              "slow_motion",
              "fade",
              "audio_gain",
              "pip",
              "hard_cut"
            ]
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "parameters": {
            "type": "object"
          }
        },
        "required": [
          "type",
          "start_ms",
          "end_ms",
          "parameters"
        ],
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "trace_id",
    "event_revision_id",
    "media_asset_id",
    "platform",
    "segments",
    "canvas",
    "operations",
    "evidence_refs"
  ]
}
